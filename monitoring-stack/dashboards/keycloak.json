            "uid": "victoriametrics"
          },
          "expr": "sum(rate(keycloak_user_events_total{namespace=\"$namespace\", pod=~\"$pod\", event=\"login\", error!=\"\"}[5m]))",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
