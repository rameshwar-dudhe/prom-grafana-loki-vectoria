    {
      "type": "table",
      "title": "Top Clients by Failed Logins",
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (client) (count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} |= \"org.keycloak.events\" |= \"LOGIN_ERROR\" | regexp `clientId=\"(?P<client>[^\"]*)\"` [$__range])))",
