    {
      "type": "logs",
      "title": "Authentication Event Log",
      "id": 17,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
